---
// The one <head> for the MINIMAL STEEL pages — see REDESIGN-PLAN.md phase A3.
//
// Owns the head only, NOT the nav/footer: /teams, /community and /verify each
// keep their own navigation shape, because the home nav's links are all
// in-page anchors that exist on `/` alone.
//
// Before this file the Metrika snippet was pasted into 7 pages and the
// @fontsource list into 5, with four different subset combinations.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/primitives.css';
import '../styles/components.css';

interface Props {
  title: string;
  noindex?: boolean;
}
const { title, noindex = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
{noindex && <meta name="robots" content="noindex" />}
