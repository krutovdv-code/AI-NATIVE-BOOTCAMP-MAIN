<script is:inline>
  // Phase 0 note: hooks are data-js, never visual classes — a restyle in
  // Phase C must not be able to break behaviour. See REDESIGN-PLAN.md rule 10.

  // --- lesson accordion (curriculum) ---
  document.querySelectorAll('[data-js="lesson"]').forEach(function (lesson) {
    var toggle = lesson.querySelector('[data-js="lesson-toggle"]');
    var panel = lesson.querySelector('.lesson__panel');
    if (!toggle || !panel) return;
    toggle.addEventListener('click', function () {
      var open = lesson.dataset.open === 'true';
      lesson.dataset.open = String(!open);
      toggle.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
  });

  // --- burger ---
  var burger = document.querySelector('[data-js="burger"]');
  var burgerPanel = document.getElementById('nav-panel');
  if (burger && burgerPanel) {
    burger.addEventListener('click', function () {
      var open = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!open));
      burgerPanel.classList.toggle('is-open', !open);
    });
  }

  // --- quicknav (hero jump-to bar) ---
  (function () {
    var wrap = document.querySelector('[data-js="quicknav"]');
    var toggle = document.querySelector('[data-js="quicknav-toggle"]');
    var panel = wrap && wrap.querySelector('.quicknav__panel');
    if (!wrap || !toggle || !panel) return;
    toggle.addEventListener('click', function () {
      var open = wrap.dataset.open === 'true';
      wrap.dataset.open = String(!open);
      toggle.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
    wrap.querySelectorAll('[data-js="quicknav-link"]').forEach(function (link) {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        wrap.dataset.open = 'false';
        toggle.setAttribute('aria-expanded', 'false');
        panel.hidden = true;
        var target = document.querySelector(link.getAttribute('href'));
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  })();

  // --- tabs (about) ---
  (function () {
    var wrap = document.querySelector('[data-js="tabs"]');
    if (!wrap) return;
    var btns = wrap.querySelectorAll('[data-js="tabs-btn"]');
    var panels = wrap.querySelectorAll('.tabs__panel');
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-tab');
        btns.forEach(function (b) {
          var on = b === btn;
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panels.forEach(function (p) {
          if (p.getAttribute('data-panel') === id) p.setAttribute('data-active', 'true');
          else p.removeAttribute('data-active');
        });
      });
    });
  })();

  // --- prereq popover ---
  (function () {
    var btn = document.querySelector('[data-js="popover-toggle"]');
    var pop = document.getElementById('prereq-hint');
    if (!btn || !pop) return;
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = !pop.hasAttribute('hidden');
      pop.toggleAttribute('hidden', open);
      btn.setAttribute('aria-expanded', String(!open));
    });
    document.addEventListener('click', function () {
      if (!pop.hasAttribute('hidden')) { pop.setAttribute('hidden', ''); btn.setAttribute('aria-expanded', 'false'); }
    });
  })();

  // --- FAQ accordion ---
  document.querySelectorAll('[data-js="faq-row"]').forEach(function (row) {
    var toggle = row.querySelector('[data-js="faq-toggle"]');
    var answer = row.querySelector('.faq__a');
    if (!toggle || !answer) return;
    toggle.addEventListener('click', function () {
      var open = row.dataset.open === 'true';
      row.dataset.open = String(!open);
      toggle.setAttribute('aria-expanded', String(!open));
      answer.hidden = open;
    });
  });

  // --- streams (feedback roster) ---
  document.querySelectorAll('[data-js="stream-btn"]:not([disabled])').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = btn.getAttribute('data-stream');
      var panel = document.querySelector('[data-stream-panel="' + id + '"]');
      var open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      if (panel) panel.toggleAttribute('data-open', !open);
    });
  });

  // --- carousel (feedback testimonials) ---
  (function () {
    var track = document.querySelector('[data-js="carousel-track"]');
    var prev = document.querySelector('[data-js="carousel-prev"]');
    var next = document.querySelector('[data-js="carousel-next"]');
    if (!track) return;
    function cardWidth() {
      var card = track.querySelector('.carousel__card');
      return card ? card.getBoundingClientRect().width + 24 : 340;
    }
    // Width of ONE copy of the list: the offset of the first clone. NOT
    // scrollWidth/2 — the two halves share one gap and there is no trailing
    // one, so that is half a gap short and every wrap would drift off the snap
    // points. Measuring the clone is exact whatever the gap and padding are.
    function loop() {
      var kids = track.children;
      return kids[kids.length / 2].offsetLeft - kids[0].offsetLeft;
    }
    // Realign BEFORE scrolling, never during: assigning scrollLeft mid-flight
    // cancels the smooth animation, and the wrap is the one place it would be
    // most visible. Both ends stay a full copy away from the real edge, so
    // neither arrow can ever dead-end.
    function step(dir) {
      var L = loop();
      if (dir > 0 && track.scrollLeft >= L) track.scrollLeft -= L;
      else if (dir < 0 && track.scrollLeft < cardWidth()) track.scrollLeft += L;
      track.scrollBy({ left: dir * cardWidth(), behavior: 'smooth' });
    }
    prev && prev.addEventListener('click', function () { step(-1); });
    next && next.addEventListener('click', function () { step(1); });
  })();

  // --- generic modal system: one implementation for format / lesson-format /
  // video / widget, driven by data-modal="<name>" + data-modal-open="<name>".
  // See REDESIGN-PLAN.md Phase A5: this is the consolidation it asks for. ---
  (function () {
    var modals = {};
    document.querySelectorAll('[data-js="modal"]').forEach(function (m) {
      modals[m.getAttribute('data-modal')] = m;
    });
    var lastFocused = null;

    // idx.xl.ru application widget. Injected on FIRST open, not on page load:
    // it is a third-party render-blocking script and most visitors never open
    // the form. Two widget ids share one modal — team format and regular —
    // so the mounted id is tracked and the container emptied when it changes.
    var mountedWidgetId = null;
    function mountWidget(modal, widgetId) {
      var body = modal.querySelector('[data-js="widget-body"]');
      if (!body || widgetId === mountedWidgetId) return;
      body.innerHTML = '';
      mountedWidgetId = widgetId;
      var s = document.createElement('script');
      s.setAttribute('ao-number', '3272');
      s.setAttribute('ao-widget-id', widgetId);
      s.setAttribute('ao-domain', 'content.scalingclub.ru');
      s.src = 'https://idx.xl.ru/site/widget/widget.min.js';
      s.async = true;
      body.appendChild(s);
    }

    function openModal(name, widgetId) {
      var modal = modals[name];
      if (!modal) return;
      lastFocused = document.activeElement;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      var dialog = modal.querySelector('.modal__dialog');
      if (dialog) dialog.focus();
      modal.querySelectorAll('[data-js="modal-video"]').forEach(function (iframe) {
        if (!iframe.getAttribute('src')) iframe.setAttribute('src', iframe.getAttribute('data-src'));
      });
      if (name === 'widget' && widgetId) mountWidget(modal, widgetId);
    }
    function closeModal(modal) {
      modal.hidden = true;
      document.body.style.overflow = '';
      modal.querySelectorAll('[data-js="modal-video"]').forEach(function (iframe) { iframe.removeAttribute('src'); });
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
    }
    function openModals() {
      return Array.prototype.slice.call(document.querySelectorAll('[data-js="modal"]')).filter(function (m) { return !m.hidden; });
    }

    document.querySelectorAll('[data-modal-open]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (burgerPanel) burgerPanel.classList.remove('is-open');
        openModal(btn.getAttribute('data-modal-open'), btn.getAttribute('data-widget-id'));
      });
    });
    document.querySelectorAll('[data-js="modal-close"]').forEach(function (el) {
      el.addEventListener('click', function () {
        var modal = el.closest('[data-js="modal"]');
        if (modal) closeModal(modal);
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      openModals().forEach(closeModal);
    });
  })();

  // --- format modal load toggle ---
  (function () {
    var seg = document.querySelector('[data-js="load-toggle"]');
    if (!seg) return;
    var hoursEl = document.querySelector('[data-js="load-hours"]');
    var noteEl = document.querySelector('[data-js="load-note"]');
    var LOAD = {
      webinar: { hours: '2–3 часа', note: 'в неделю, до 4–6 часов в недели с двумя встречами' },
      full: { hours: '4–8 часов', note: 'в неделю, с практикой на своём проекте' },
    };
    seg.querySelectorAll('[data-load]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        seg.querySelectorAll('[data-load]').forEach(function (b) { b.setAttribute('aria-selected', 'false'); });
        btn.setAttribute('aria-selected', 'true');
        var mode = LOAD[btn.getAttribute('data-load')];
        if (hoursEl) hoursEl.textContent = mode.hours;
        if (noteEl) noteEl.textContent = mode.note;
      });
    });
  })();
</script>

</body>
</html>
