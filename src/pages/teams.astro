---
// Teams — корпоративное участие в буткемпе.
// On the «MINIMAL STEEL» design system; see REDESIGN-PLAN.md phase C.
//
// Pure reskin: every string carries over verbatim from the previous version.
// The page keeps its own light chrome (.subnav / .subfooter) rather than the
// home page's .nav — that nav's links are all in-page anchors that only
// exist on `/`.
//
// The three hand-rolled modals (teams widget, consult widget, term popover)
// collapsed into the shared data-modal system in src/scripts/common.js.
import BaseLayout from '../layouts/BaseLayout.astro';

const sources = [
  {
    num: '01',
    title: 'Google Cloud DORA 2025',
    text: 'Adoption AI среди разработчиков выросла до 90%, с приростом 14 процентных пунктов за год, и в среднем разработчики тратят на работу с AI два часа в день. При этом AI не чинит команду сам по себе — он усиливает то, что уже есть: сильные команды становятся эффективнее, а слабые получают те же проблемы, только острее. Рост объёма кода без соответствующего усиления процессов review и тестирования увеличивает нестабильность поставки.',
    url: 'https://cloud.google.com/blog/products/ai-machine-learning/announcing-the-2025-dora-report',
  },
  {
    num: '02',
    title: 'Stack Overflow Developer Survey 2025',
    text: '84% разработчиков уже используют или планируют использовать AI-инструменты в работе, рост с 76% годом ранее. Но доверие к точности результатов при этом упало до 29%, снизившись с 40% годом ранее — рост adoption сопровождается ростом недоверия, а не наоборот.',
    url: 'https://survey.stackoverflow.co/2025/ai/',
  },
  {
    num: '03',
    title: 'Techreviewer, «AI in Software Development 2025: From Exploration to Accountability»',
    text: '97,5% компаний-разработчиков программного обеспечения так или иначе внедрили AI в свой SDLC, рост с 90,9% в 2024 году.',
    url: 'https://techreviewer.co/blog/ai-in-software-development-2025-from-exploration-to-accountability-a-global-survey-analysis',
  },
  {
    num: '04',
    title: 'McKinsey, «Unleashing developer productivity with generative AI»',
    text: 'Использование генеративного AI ускоряет типовые задачи разработки: документация выполняется на 45–50% быстрее, генерация кода на 35–45%, рефакторинг на 20–30%.',
    url: 'https://www.mckinsey.com/capabilities/mckinsey-digital/our-insights/unleashing-developer-productivity-with-generative-ai',
  },
  {
    num: '05',
    title: 'Futurum Research, «AI Reaches 97% of Software Development Organizations»',
    text: '97% организаций уже используют AI в разработке программного обеспечения (76,6% активно, ещё 20,4% на стадии внедрения), только 3,1% остаются в стороне.',
    url: 'https://futurumgroup.com/press-release/ai-reaches-97-of-software-development-organizations/',
  },
];

const levers = [
  {
    tag: 'Рычаг 01',
    title: 'Экономия и эффективность',
    items: [
      'Ускорение разработки и снижение доли ручного труда.',
      'Автоматизация части рутинных операций в документации, тестировании, ревью и поддержке legacy.',
      'Снижение зависимости от подрядчиков и экстенсивного расширения штата при росте задач.',
    ],
  },
  {
    tag: 'Рычаг 02',
    title: 'Рост выручки и прибыли',
    items: [
      'Более быстрый вывод новых фич и продуктов на рынок.',
      'Появление новых AI-продуктов и сервисов в продуктовой линейке.',
      'Улучшение клиентского опыта, удержания и монетизации за счёт AI-функций.',
    ],
  },
];

const symptoms = [
  { tag: 'Симптом 01', title: 'Много PoC, мало продакшена', text: 'AI остаётся на уровне демо и не доходит до рабочих процессов.' },
  { tag: 'Симптом 02', title: 'Инструменты без системы', text: 'Команды пробуют инструменты, но не строят систему. Есть точечное использование, но не хватает навыков интеграции, контроля качества и масштабирования.' },
  { tag: 'Симптом 03', title: 'Разрыв между бизнесом и инженерами', text: 'Бизнес ждёт ROI, инженеры — чётких постановок, и между ними часто нет общего языка про AI.' },
  { tag: 'Симптом 04', title: 'Разовые воркшопы не дают трансформации', text: 'Для результата нужен не вдохновляющий обзор, а системный апгрейд ключевых людей и рабочих практик.' },
];

const doubleValue = [
  {
    head: 'Для компании и руководителей',
    items: [
      'Ускорение delivery и снижение себестоимости разработки за счёт AI-инструментов в ежедневной работе команды.',
      'Формирование внутреннего AI-ядра — группы людей, на которых можно опереть дальнейшую трансформацию.',
      'Появление у компании общего языка про AI, ROI, риски и применимость AI в реальных процессах.',
      'Снижение зависимости от единичных энтузиастов: знания и практики распределяются по команде.',
      'Усиление HR-бренда: инвестиции в AI-компетенции повышают привлекательность компании для сильных инженеров.',
    ],
  },
  {
    head: 'Для сотрудников',
    items: [
      'Освоение востребованных AI-навыков, которые уже становятся стандартом сильного инженера.',
      'Карьерный рост: движение в сторону AI-driven engineer, технического лидера, архитектора решений.',
      'Практика на реальных рабочих задачах, а не абстрактных упражнениях.',
      'Рост мотивации и вовлечённости: люди видят, что компания инвестирует в их развитие и будущее.',
      'Командообразование: общий понятийный аппарат, общие инструменты и совместная работа над новыми подходами.',
    ],
  },
];

const outcomes = [
  {
    head: 'Для компании',
    items: [
      'Команда, которая лучше понимает, как применять AI в реальных процессах компании.',
      'Подготовленные и приоритизированные AI-кейсы для дальнейшего внедрения.',
      'Набор практик, шаблонов и подходов, которые можно использовать в ежедневной работе.',
      'Более зрелый внутренний разговор про AI: где он действительно создаёт ценность, а где — нет.',
      'Основа для последующей трансформации процессов, ролей и инженерного контура.',
    ],
  },
  {
    head: 'Для каждого участника',
    items: [
      'Практический опыт применения AI-инструментов в ежедневной инженерной работе: от IDE и LLM до агентов, API и работы с legacy.',
      'Более сильная личная рабочая система: умение быстрее исследовать, проектировать, писать, проверять и дорабатывать решения с помощью AI.',
      'Собранный personal toolkit: набор инструментов, паттернов, промптов и подходов, которые можно сразу переносить в свою работу.',
      'Понимание, как применять AI не «в вакууме», а в production-контексте компании, с учётом SDLC, качества и ROI.',
      'Более сильная профессиональная позиция на рынке: участник начинает мыслить и действовать как AI-driven engineer.',
    ],
  },
];

const nextSteps = [
  'На ознакомительном звонке разбираем состав команды, задачи и целевой эффект.',
  'Подбираем оптимальный формат участия и обсуждаем, как встроить программу в контекст компании.',
  'По итогам разговора формируем предложение под вашу ситуацию.',
];

// Both packages come from the same idx.xl.ru widget as the home page's team
// format — one modal, one widget id, opened from three different buttons.
const TEAMS_WIDGET = 'cGq_8BNde06mP32lZwU9DQ';
const CONSULT_WIDGET = 'SRqLxYwJH0OQRbGoN4wrYQ';
---
<BaseLayout title="Для команд — AI DRIVEN РАЗРАБОТКА">

<!-- ============================== SUBNAV ============================== -->
<header class="subnav">
  <a class="lockup__name" href="/">НЭЙШН</a>
  <span class="subnav__tag">// Для команд</span>
  <a class="subnav__back" href="/">← Основная программа</a>
</header>

<!-- ============================== HERO ============================== -->
<section class="hero">
  <div class="hero__inner">
    <p class="hero__eyebrow">[BOOTCAMP_B2B] // AI-DRIVEN DEVELOPMENT</p>
    <h1 class="hero__title hero__title--long">AI-Driven Bootcamp <br> для <span class="hero__title-mark">инженерных команд</span></h1>
    <h2 class="hero__sub">Апгрейд роли разработчика и представителей продуктовых команд IT</h2>
    <p class="hero__lead">Трансформация компаний через встраивание AI в реальные процессы компании</p>
    <div class="cta-row">
      <button type="button" class="btn btn--solid btn--wide" data-modal-open="widget" data-widget-id={TEAMS_WIDGET}>Обсудить условия</button>
    </div>
  </div>
</section>

<!-- ============================== ВИДЕНИЕ ============================== -->
<section class="section section--bg" id="vision" aria-label="Видение">
  <div class="section__inner">
    <div class="section__head">
      <div class="section__head-l">
        <p class="section__eyebrow">[видение] // AI-driven — это новый стандарт</p>
        <h2 class="section__title">Рынок переходит <br> к <span class="section__title-mark">AI-driven</span> компаниям</h2>
      </div>
      <div class="section__head-r section__head-r--tight">
        <div class="section__rule"></div>
        <div class="plate plate--mint">
          <p class="plate__text">AI-driven — это новый стандарт конкурентоспособности, а не модный эксперимент</p>
        </div>
      </div>
    </div>

    <div class="prose">
      <p>AI меняет не отдельные задачи, а всю цепочку создания ценности: продукт, разработку, эксплуатацию, продажи и поддержку.</p>
      <p>Выигрывают компании, которые перестраивают процессы под AI, а не те, кто просто раздал сотрудникам доступ к инструментам и ждёт эффекта.</p>
    </div>

    <div class="grid-2">
      {sources.map((s, i) => (
        <article class={i === sources.length - 1 ? 'card card--span' : 'card'}>
          <p class="card__num">{s.num}</p>
          <h3 class="card__title">{s.title}</h3>
          <p class="card__text">{s.text}</p>
          <a class="link-arrow" href={s.url} target="_blank" rel="noopener noreferrer">Ссылка →</a>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============================== БИЗНЕС-ЦЕННОСТЬ ============================== -->
<section class="section section--white" id="value" aria-label="Бизнес-ценность">
  <div class="section__inner">
    <div class="section__head">
      <div class="section__head-l">
        <p class="section__eyebrow">[бизнес-ценность] // AI — это не только про экономию</p>
        <h2 class="section__title">Два рычага, которые <br> даёт <span class="section__title-mark">AI</span> бизнесу</h2>
      </div>
    </div>

    <div class="grid-2">
      {levers.map((l) => (
        <article class="card card--grey">
          <p class="card__num">{l.tag}</p>
          <h3 class="card__title">{l.title}</h3>
          <ul class="bullets">
            {l.items.map((i) => <li>{i}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <div class="plate">
      <p class="plate__text"><strong>Вывод для руководителей:</strong> фокусироваться только на сокращении расходов — значит недополучить значительную часть эффекта от AI.</p>
    </div>
  </div>
</section>

<!-- ============================== ПРОБЛЕМА ============================== -->
<section class="section section--bg" id="problems" aria-label="Почему AI-инициативы буксуют">
  <div class="section__inner">
    <div class="section__head">
      <div class="section__head-l">
        <p class="section__eyebrow">[проблема] // Почему AI-инициативы буксуют</p>
        <h2 class="section__title">Знакомые симптомы <br> «кустарного» <span class="section__title-mark">AI</span></h2>
      </div>
    </div>

    <div class="grid-2">
      {symptoms.map((s) => (
        <article class="card">
          <p class="card__num">{s.tag}</p>
          <h3 class="card__title">{s.title}</h3>
          <p class="card__text">{s.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============================== ДВОЙНАЯ ЦЕННОСТЬ ============================== -->
<section class="section section--white" id="dvalue" aria-label="Двойная выгода">
  <div class="section__inner">
    <div class="section__head">
      <div class="section__head-l">
        <p class="section__eyebrow">[ценность] // Двойная выгода</p>
        <h2 class="section__title">Один продукт — две <br> сильные <span class="section__title-mark">ценности</span> <br> внутри заказчика</h2>
      </div>
    </div>

    <div class="grid-2">
      {doubleValue.map((c) => (
        <article class="card card--grey">
          <h3 class="card__title">{c.head}</h3>
          <ul class="bullets">
            {c.items.map((i) => <li>{i}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============================== ФОРМАТЫ ============================== -->
<section class="section section--bg" id="packages" aria-label="Варианты для корпоративных клиентов">
  <div class="section__inner">
    <div class="section__head">
      <div class="section__head-l">
        <p class="section__eyebrow">[форматы] // Варианты для корпоративных клиентов</p>
        <h2 class="section__title">Варианты реализации <br> для <span class="section__title-mark">корпоративных</span> клиентов</h2>
      </div>
    </div>

    <div class="grid-2">
      <article class="card">
        <p class="card__num">Базовый пакет</p>
        <h3 class="card__title">Индивидуально / Групповое участие</h3>
        <p class="card__text">Минимум кастомизации, максимум скорости, чтобы завести людей в новый стандарт работы</p>
        <ul class="bullets">
          <li class="bullets__key">Команда учится на общем потоке и получает весь спектр навыков</li>
          <li class="bullets__key">Прогрессивная скидка по количеству представителей</li>
          <li>Дополнительная групповая встреча по развитию отрасли, команд, трендам экспертов буктемпа с участниками от компании</li>
        </ul>
      </article>

      <article class="card">
        <p class="card__num">Командное сопровождение</p>
        <h3 class="card__title">С дополнительной поддержкой</h3>
        <p class="card__text">Фокус на первых 1–3 реальных кейсах компании и сопровождении внедрения</p>
        <ul class="bullets">
          <li class="bullets__key">«Мини-акселератор» по AI-driven разработке внутри компании</li>
          <li class="bullets__key">Дополнительный <button type="button" class="link-term" data-modal-open="term-trekshn">трекшн</button> внедрения изменений в рамках закрытого клуба</li>
          <li>Отдельный чат для команды</li>
          <li>1 стратегический созвон с тех/прод-лидами в начале и 1 в конце по итогам</li>
          <li>Работа с экспертами по отдельным задачам команды</li>
          <li>Адаптация части примеров и домашних заданий под технологический стек заказчика</li>
          <li>Дополнительные промежуточные групповые Q&amp;A, разборы кейсов компании</li>
        </ul>
      </article>
    </div>

    <div class="plate plate--row">
      <p class="plate__text">К каждой команде индивидуальный подход</p>
      <button type="button" class="btn btn--solid btn--wide" data-modal-open="widget" data-widget-id={TEAMS_WIDGET}>Обсудить условия</button>
    </div>

    <div class="plate plate--mint plate--row">
      <div class="plate__body">
        <p class="plate__label">Индивидуальный формат</p>
        <p class="plate__text">Для компаний, которым нужен внешний партнёр по AI-трансформации. Разрабатывается отдельно после ряда встреч с командой Naition.</p>
      </div>
      <button type="button" class="btn btn--solid btn--wide" data-modal-open="widget" data-widget-id={CONSULT_WIDGET}>Получить консультацию</button>
    </div>
  </div>
</section>

<!-- ============================== РЕЗУЛЬТАТ ============================== -->
<section class="section section--white" id="outcomes" aria-label="Что остаётся после буткемпа">
  <div class="section__inner">
    <div class="section__head">
      <div class="section__head-l">
        <p class="section__eyebrow">[результат] // Что остаётся после буктемпа</p>
        <h2 class="section__title">Измеримые <span class="section__title-mark">артефакты</span>, <br> а не просто факт обучения</h2>
      </div>
    </div>

    <div class="grid-2">
      {outcomes.map((c) => (
        <article class="card card--grey">
          <h3 class="card__title">{c.head}</h3>
          <ul class="bullets">
            {c.items.map((i) => <li>{i}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============================== СЛЕДУЮЩИЙ ШАГ ============================== -->
<section class="section section--dark" id="cta" aria-label="Следующий шаг">
  <div class="section__inner">
    <div class="section__head">
      <div class="section__head-l">
        <p class="section__eyebrow">[следующий шаг] // 30 минут на сценарий запуска</p>
        <h2 class="section__title">30 минут — и у вас будет <br> понятный <span class="section__title-mark">сценарий запуска</span> <br> для вашей команды</h2>
      </div>
      <div class="section__head-r">
        <ul class="bullets">
          {nextSteps.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
    <div class="cta-row">
      <button type="button" class="btn btn--mint btn--wide" data-modal-open="widget" data-widget-id={TEAMS_WIDGET}>Обсудить условия</button>
    </div>
  </div>
</section>

<!-- ============================== SUBFOOTER ============================== -->
<footer class="subfooter">
  <a href="/">← AI DRIVEN РАЗРАБОТКА</a>
  <span>© 2026 NAITION</span>
  <div class="subfooter__links">
    <a href="/legal/oferta">Оферта</a>
    <a href="/legal/privacy">Политика</a>
  </div>
</footer>

<!-- ============================== MODALS ============================== -->
<div class="modal" data-js="modal" data-modal="widget" hidden>
  <div class="modal__backdrop" data-js="modal-close"></div>
  <div class="modal__dialog" role="dialog" aria-modal="true" aria-label="Заявка" tabindex="-1">
    <button type="button" class="modal__x" data-js="modal-close" aria-label="Закрыть">✕</button>
    <div class="modal__widget" data-js="widget-body"></div>
  </div>
</div>

<div class="modal" data-js="modal" data-modal="term-trekshn" hidden>
  <div class="modal__backdrop" data-js="modal-close"></div>
  <div class="modal__dialog" role="dialog" aria-modal="true" aria-label="Трекшн" tabindex="-1">
    <button type="button" class="modal__x" data-js="modal-close" aria-label="Закрыть">✕</button>
    <p class="modal__lead"><strong>Трекшн</strong> — сопровождение внедрения практик и подходов, начиная с аудита ваших процессов до результатов и их анализа. Длится 3 месяца.</p>
  </div>
</div>

<script>import '../scripts/common.js';</script>

</BaseLayout>
