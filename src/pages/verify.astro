---
import VerifyLayout from "../layouts/VerifyLayout.astro";
import certificates from "../data/certificates.json";

// В браузер уходят только идентификаторы (они и так напечатаны на сертификатах),
// имена не публикуем — их отдают только собственные страницы /verify/[id].
const ids = certificates.map((c) => c.id);
---
<VerifyLayout title="Проверка сертификата — NAITION">
  <div class="verify__card">
    <p class="section__eyebrow">[ VERIFY ] // ПРОВЕРКА СЕРТИФИКАТА</p>
    <p class="verify__lead">Отсканируйте QR-код на сертификате или введите его идентификатор, чтобы подтвердить подлинность.</p>
    <form class="field" id="v-form" novalidate>
      <input
        class="field__input"
        id="v-input"
        type="text"
        name="id"
        inputmode="text"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        placeholder="Например: 01-001-160726-E9E4"
        aria-label="Идентификатор сертификата"
        aria-describedby="v-error"
      />
      <p class="field__error" id="v-error" role="alert" hidden>Сертификат с таким идентификатором не найден. Проверьте, что код введён полностью и без опечаток.</p>
      <button class="btn btn--solid field__submit" type="submit">Проверить</button>
    </form>
  </div>

  <script is:inline define:vars={{ ids }}>
    (function () {
      var form = document.getElementById('v-form');
      var input = document.getElementById('v-input');
      var error = document.getElementById('v-error');
      var valid = new Set(ids.map(function (s) { return s.toUpperCase(); }));
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var id = input.value.trim().toUpperCase();
        if (!id) { input.focus(); return; }
        if (valid.has(id)) {
          window.location.href = '/verify/' + id;
        } else {
          error.hidden = false;
        }
      });
      input.addEventListener('input', function () { error.hidden = true; });
    })();
  </script>
</VerifyLayout>
