---
// Naition Community — клуб практикующих.
// On the «MINIMAL STEEL» design system; see REDESIGN-PLAN.md phase C.
//
// Pure reskin: every string carries over verbatim. Two changes that are not
// copy:
//   · both CTAs pointed at /#apply, an anchor that does not exist on the home
//     page (REDESIGN-PLAN.md bug 5). They now point at /#register, which does.
//   · the page loaded /fonts/fonts.css — 174 KB of base64 with no weight 900
//     and no latin subset, so its headings were faux-bold (bug 7). It is on
//     @fontsource via BaseLayout now, like every other page.
import BaseLayout from '../layouts/BaseLayout.astro';

const APPLY = '/#register';

const elements = [
  { num: '01', title: 'Закрытый Telegram-чат с выпускниками и экспертами', text: 'Место, где можно задать вопрос по своему проекту и получить ответ не от случайного человека из интернета, а от того, кто прошёл ту же программу и уже съел не одну собаку на AI-внедрениях. Ведущие инструкторы и программный комитет остаются в чате и после окончания буткемпа.' },
  { num: '02', title: 'Живые встречи раз в две недели', text: 'Разбор реальных кейсов, архитектурных решений, новых инструментов. Эксперты рассказывают, как у них устроено внутри — в Сбере, VK, Яндексе, Meta, Google. Между встречами — записи в библиотеке.' },
  { num: '03', title: 'Кейс-клубы', text: 'Участники приносят свои ситуации с работы: застрял на рефакторинге легаси с агентами, не получается выстроить ревью мультиагентного кода, команда саботирует внедрение. Разбираем вживую, с обсуждением, до решения.' },
  { num: '04', title: 'Обновляемая библиотека материалов', text: 'AI-инструменты меняются каждые несколько месяцев. Программа буткемпа не замораживается после выпуска первой когорты, а продолжает обновляться. Участники клуба получают доступ к обновлениям и новым модулям по мере их выхода.' },
  { num: '05', title: 'Поддержка при внедрении в команду', text: 'Когда нужен совет от людей, которые прошли этот путь: как убедить скептически настроенного тимлида, как выстроить code review агентского кода, как обучать джунов в новой реальности. В чате есть люди с опытом внедрения в командах от 5 до 200 разработчиков.' },
  { num: '06', title: 'Нетворкинг с практиками из крупных компаний', text: 'Среди участников и экспертов — инженеры и архитекторы из Сбера, Aurora First, SymbioWay, ЦУ Т-Банка, а также программный комитет из CTO. Это окружение, в котором нормально познакомиться, обсудить подход к работе, а при случае — обменяться контактами по рабочим вопросам.' },
  { num: '07', title: 'Клубная скидка на следующие программы Naition', text: 'Следующие когорты буткемпа, интенсивы и специализированные программы — со скидкой для участников клуба.' },
];

const modes = [
  { tag: 'Активный режим', title: 'Для тех, кто упирается в AI на рабочих задачах', text: 'Для тех, кто активно внедряет AI на рабочих задачах и каждую неделю упирается в ситуации, где нужен человек рядом — тот, кто прошёл тот же путь и уже наступил на эти грабли. Таким людям клуб окупается встречами, чатом и кейс-клубами, где можно выгружать конкретные проблемы и получать конкретные ответы.' },
  { tag: 'Фоновый режим', title: 'Для тех, кто хочет держать руку на пульсе', text: 'Для тех, у кого задач по AI меньше, но кто хочет держать руку на пульсе индустрии без отдельного выделенного на это времени. Дайджесты чата, записи встреч, обновления библиотеки — всё это работает и при пассивном участии. Через полгода в таком режиме у человека набирается ощутимый массив практик, которых не было бы без клуба.' },
];

const doubts = [
  { q: '«У меня нет времени на ещё одно сообщество»', a: 'У большинства участников его тоже нет. Поэтому клуб устроен так, что пользу получают и те, кто ходит на все встречи, и те, кто два раза в месяц просматривает дайджест. Встречи записываются, в чате есть бот с саммари по темам, библиотека доступна в любое время.' },
  { q: '«Я уже состою в других AI-сообществах»', a: 'В общих AI-сообществах разный уровень участников — от студентов до CTO. Здесь все прошли или проходят одну программу и говорят на одном языке. Не нужно объяснять, что такое контекст-инжиниринг или зачем нужен AGENTS.md — можно сразу обсуждать, как применять это у себя.' },
  { q: '«Что мне даст общение с другими выпускниками — они же на том же уровне»', a: 'У каждого свой стек, своя команда, свои задачи. Человек, который внедрил мультиагентного помощника в финтехе, и человек, который настроил пайплайн для рефакторинга легаси в геймдеве, решали одну проблему разными путями. Обмен такими путями и есть главное, что даёт клуб.' },
  { q: '«Не уверен, что буду применять на своих задачах»', a: 'Буткемп и клуб рассчитаны на людей, которые уже работают в продакшене. Если у тебя есть кодовая база и команда — применять будет где. Если сомневаешься в этом конкретном кейсе, подожди, пока пройдёшь несколько уроков — станет понятно, нужен тебе клуб или нет.' },
  { q: '«Это же просто чат, зачем за него платить»', a: 'За бесплатный чат обычно платят другим — временем на фильтрацию шума, догоняние контекста с нуля, поиск проверенных практик среди сомнительных. Клуб закрытый и модерируется, участники проходят отбор через буткемп, эксперты отвечают лично. Это другой продукт.' },
];

const environment = [
  'AI-инструменты меняются каждые несколько месяцев. То, что работало в марте, к июню уже не актуально. Самостоятельно отслеживать — это отдельная работа, которой у занятого разработчика нет. Самостоятельно пробовать и тестировать — это часы экспериментов, которые заканчиваются нестабильными результатами, откатами и решениями, которые не доводятся до продакшена.',
  'Клуб решает эту проблему окружением. Когда рядом люди с теми же задачами, новое не нужно догонять специально. Оно приходит через разговор. Кто-то уже попробовал инструмент и принёс результат. Кто-то уже совершил ошибку и рассказал о ней, чтобы её не повторили остальные. Практики просачиваются через обсуждения быстрее, чем через блоги и документацию.',
  'И главное: решения, которые здесь обсуждаются, уже применены в продакшене. Не теоретически работающие, а те, которые прошли ревью, тесты, откаты и доведение до рабочего состояния. Это экономит тот самый месяц проб и ошибок, который иначе уходит на проверку каждого нового подхода.',
];
---
<BaseLayout title="Naition Community — клуб практикующих">

<!-- ============================== SUBNAV ============================== -->
<header class="subnav">
  <a class="lockup__name" href="/">НЭЙШН</a>
  <span class="subnav__dot" aria-hidden="true"></span>
  <span class="subnav__tag">Community</span>
</header>

<!-- ============================== HERO ============================== -->
<section class="hero">
  <div class="hero__inner">
    <p class="hero__eyebrow">// HERO</p>
    <h1 class="hero__title hero__title--long">Закрытый клуб практикующих разработчиков, которые системно внедряют <span class="hero__title-mark">AI</span> в свои команды</h1>
    <p class="hero__lead">
      Буткемп заканчивается через 12 недель. Работа с AI — нет. Naition продолжает программу для тех, кто уже начал встраивать инструменты в свои проекты и команды, и хочет делать это с поддержкой, а не в одиночку.
    </p>
    <p class="hero__lead">
      Раз в две недели встречаемся с экспертами и разбираем реальные кейсы. Между встречами — чат, где обсуждают то, с чем столкнулись на этой неделе. Программа буткемпа продолжает обновляться, и участники клуба получают к ней доступ вместе с новыми материалами.
    </p>
    <div class="cta-row">
      <a class="btn btn--solid btn--wide" href={APPLY}>Подать заявку в клуб</a>
    </div>
  </div>
</section>

<!-- ============================== ЧТО ВНУТРИ ============================== -->
<section class="section section--bg" id="elements" aria-label="Что внутри клуба">
  <div class="section__inner">
    <div class="section__head">
      <div class="section__head-l">
        <p class="section__eyebrow">// что внутри</p>
        <h2 class="section__title">7 элементов клуба</h2>
      </div>
    </div>

    <div class="grid-3">
      {elements.map((e, i) => (
        <article class={i === elements.length - 1 ? 'card card--span' : 'card'}>
          <p class="card__num">{e.num}</p>
          <h3 class="card__title">{e.title}</h3>
          <p class="card__text">{e.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============================== РЕЖИМЫ ============================== -->
<section class="section section--white" id="modes" aria-label="Режимы участия">
  <div class="section__inner">
    <div class="section__head">
      <div class="section__head-l">
        <p class="section__eyebrow">// зачем вступать</p>
        <h2 class="section__title">Режимы участия</h2>
      </div>
    </div>

    <div class="grid-2">
      {modes.map((m) => (
        <article class="card card--grey">
          <p class="card__num">{m.tag}</p>
          <h3 class="card__title">{m.title}</h3>
          <p class="card__text">{m.text}</p>
        </article>
      ))}
    </div>

    <p class="section__note">Участвовать в активном или фоновом режиме — решает сам участник. Ценность клуба не в том, чтобы ходить на всё, а в том, чтобы быть в среде.</p>
  </div>
</section>

<!-- ============================== СОМНЕНИЯ ============================== -->
<section class="section section--bg" id="doubts" aria-label="Непонятные моменты">
  <div class="section__inner">
    <div class="section__head">
      <div class="section__head-l">
        <p class="section__eyebrow">// сомнения</p>
        <h2 class="section__title">Непонятные моменты</h2>
      </div>
    </div>

    <div class="faq">
      {doubts.map((d, i) => (
        <div class="faq__row" data-js="faq-row" data-open="false">
          <button type="button" class="faq__q" data-js="faq-toggle" aria-expanded="false" aria-controls={`doubt-${i}`}>
            <span>{d.q}</span>
            <span class="faq__q-mark" aria-hidden="true">+</span>
          </button>
          <div class="faq__a" id={`doubt-${i}`} hidden>{d.a}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============================== ОКРУЖЕНИЕ ============================== -->
<section class="section section--white" id="environment" aria-label="Почему важно не в одиночку">
  <div class="section__inner">
    <div class="section__head">
      <div class="section__head-l">
        <p class="section__eyebrow">// окружение</p>
        <h2 class="section__title">Почему важно не в одиночку</h2>
      </div>
    </div>

    <div class="prose">
      {environment.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<!-- ============================== КАК ПОПАСТЬ ============================== -->
<section class="section section--dark" id="enter" aria-label="Как попасть в клуб">
  <div class="section__inner">
    <div class="section__head">
      <div class="section__head-l">
        <p class="section__eyebrow">// как попасть</p>
        <h2 class="section__title">Вступить в клуб</h2>
      </div>
      <div class="section__head-r section__head-r--tight">
        <div class="section__rule"></div>
        <p class="section__note">Клуб открыт для участников буткемпа. Вступить можно во время обучения — и продолжить участие после его окончания, получая доступ ко всем активностям вместе с новыми выпускниками. Подписка оплачивается отдельно, стоимость указывается при входе.</p>
      </div>
    </div>
    <div class="cta-row">
      <a class="btn btn--mint btn--wide" href={APPLY}>Подать заявку в клуб</a>
    </div>
  </div>
</section>

<!-- ============================== SUBFOOTER ============================== -->
<footer class="subfooter">
  <span>Naition // Community</span>
  <div class="subfooter__links">
    <a href="/">naition.ai</a>
  </div>
</footer>

<script>import '../scripts/common.js';</script>

</BaseLayout>
